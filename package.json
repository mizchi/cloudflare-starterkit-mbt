{
  "name": "@mizchi/cloudflare-starterkit-mbt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Starter kit for Cloudflare Workers in MoonBit with D1 + sqlc + Pulumi + CI/CD",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "protobufjs", "sharp", "workerd"]
  },
  "scripts": {
    "build": "pnpm run clean && node scripts/patch-int64-binds.ts --verify && node scripts/check-sql-placeholder-mix.ts && moon build --target js --release && wrangler deploy --dry-run --outdir=dist && node scripts/check-worker-bundle.ts dist/worker.js",
    "clean": "rm -rf dist",
    "check": "moon check --target js && tsc --noEmit",
    "db:compile": "sqlc compile",
    "db:diff": "sqlc diff",
    "db:generate": "sqlc generate && node scripts/patch-int64-binds.ts",
    "db:verify": "node scripts/patch-int64-binds.ts --verify && node scripts/check-sql-placeholder-mix.ts",
    "dev": "pnpm run build && wrangler dev",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:staging": "pnpm run build && wrangler deploy --env staging",
    "deploy:dry-run": "pnpm run build && wrangler deploy --dry-run",
    "smoke": "node scripts/smoke.ts",
    "lint:secretlint": "secretlint --secretlintignore .gitignore \"**/*\"",
    "infra:pulumi:check": "pnpm --filter @mizchi/cloudflare-starterkit-pulumi run check",
    "infra:pulumi:preview": "pnpm --filter @mizchi/cloudflare-starterkit-pulumi run preview",
    "infra:pulumi:up": "pnpm --filter @mizchi/cloudflare-starterkit-pulumi run up"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260218.0",
    "@dotenvx/dotenvx": "^1.50.0",
    "@secretlint/secretlint-rule-preset-recommend": "^9.0.0",
    "@types/node": "^24.0.0",
    "secretlint": "^9.0.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.13.2"
  }
}
