# direnv config. `direnv allow` once per clone, then every `cd` here
# ensures the project-local binaries and git hooks are in place.

# Project-local Node binaries (wrangler, secretlint, …) without
# leaning on `pnpm exec` every time.
PATH_add ./node_modules/.bin

# Idempotently install the git hooks declared in Taskfile.pkl. pkf is
# safe to re-run (it skips when the hook shim is already correct), so
# this fires on every `cd` without measurable cost. If pkf isn't
# installed yet, fail silently — the user hasn't bootstrapped the
# repo. Re-run `direnv reload` after `pkf install` to wire it.
if has pkf; then
  pkf hooks install >/dev/null 2>&1 || true
fi
