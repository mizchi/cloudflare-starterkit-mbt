# Copy this file to .env.cloudflare and either edit values in place or
# encrypt them with `pnpm exec dotenvx encrypt -f .env.cloudflare`.
#
# The CI workflows expect `.env.cloudflare` to be committed (encrypted)
# and the matching DOTENV_PRIVATE_KEY_CLOUDFLARE to live in a GitHub
# Actions secret. See docs/cd-overview.md.

# Required for `wrangler deploy` and `wrangler d1 migrations apply`.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional: utels error tracking. The bootstrap helper in
# scripts/setup-utels.example.mjs registers a project per env and
# emits these tokens. Setting either disables/enables the integration
# at runtime; production and staging usually have different tokens.
UTELS_INGEST_TOKEN=
UTELS_INGEST_TOKEN_STAGING=

# Optional: OTLP export (any backend that speaks OTLP/HTTP/JSON).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Optional: Cloudflare Access service-token creds, used by the smoke
# check when the worker is gated by an Access app. Production and
# staging typically gate different paths; the smoke script reads
# *_STAGING when DEPLOY_ENV=staging.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
CF_ACCESS_CLIENT_ID_STAGING=
CF_ACCESS_CLIENT_SECRET_STAGING=
